# === LLM Providers ===
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# === Real Footage APIs (free keys recommended) ===
PEXELS_API_KEY=
PIXABAY_API_KEY=

# === Voiceover: ElevenLabs Primary + Automatic Edge-TTS (en-US-AndrewNeural) Fallback ===
ELEVENLABS_API_KEY=
# Leave blank for default Adam (pNInz6obpgDQGcFmaJgB) or paste your chosen ElevenLabs Voice ID
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# === Optional Brand Overrides (defaults read from config/brand.yaml) ===
# BRAND_NAME=Bill_Explains
# BRAND_HANDLE=@bill_explains

# === 24/7 Schedule (WIB / Asia/Jakarta) for Docker/VPS ===
SCHEDULE_TIMES_WIB=04:00,21:00
AUTO_UPLOAD_GDRIVE=true
GDRIVE_ROOT_FOLDER=EverydaySciTech_Studio
GDRIVE_WEBHOOK_URL=
GDRIVE_WEBHOOK_TOKEN=
# Optional: separate Apps Script Web App on YouTube channel account while keeping files in Pro Drive
# YOUTUBE_WEBHOOK_URL=
# YOUTUBE_WEBHOOK_TOKEN=
STUDIO_SHEET_ID=
NOTIFY_EMAIL_TO=researchfalsyabillah@gmail.com
NOTIFY_EMAIL_ALSO=true

# === Telegram Notification & Feedback Bridge ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === AGENT 7: Social Publishing ===
# "dry_run" | "draft" (YouTube Unlisted) | "public"
PUBLISH_MODE=draft

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
PUBLIC_MEDIA_BASE_URL=

TIKTOK_ACCESS_TOKEN=

SOCIAL_BRIDGE_WEBHOOK_URL=
SOCIAL_BRIDGE_API_KEY=
